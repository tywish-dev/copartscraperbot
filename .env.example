# Telegram (required)
TELEGRAM_BOT_TOKEN=
# Optional: seeds the first admin user on startup (private chat ID equals user ID)
TELEGRAM_CHAT_ID=

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO_NUMBER=whatsapp:+1XXXXXXXXXX
ENABLE_WHATSAPP=false

# Scheduler (automatic checks — no /check needed)
CHECK_INTERVAL_MINUTES=60

# Browser scraper (Chrome recommended, Edge as fallback)
BROWSER=chrome
SELENIUM_HEADLESS=true
SELENIUM_PAGE_TIMEOUT=45
MAX_SCRAPE_PAGES=20
# How many browser scrapes can run at once (use 1 on small cloud instances)
MAX_CONCURRENT_SCANS=2

# Cloud / Docker persistent storage (SQLite + logs). Leave unset for local dev.
# DATA_DIR=/data

# Skip the heavy startup scan on deploy (scheduled scan still runs)
# SKIP_INITIAL_SCAN=true
